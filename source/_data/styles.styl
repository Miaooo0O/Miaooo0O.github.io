body {
  background: #f4f3ee;
}
.header-inner, .sidebar-inner, .post-block, .pagination {
  border-radius: 14px;
  overflow: hidden;
}
.site-brand-container {
  background: #183d3b;
  padding: 32px 18px;
}
.site-title {
  font-size: 20px;
  font-weight: 600;
  letter-spacing: 0;
}
.site-subtitle {
  color: #dce9e4;
  margin-top: 12px;
  font-size: 13px;
}
.menu-item a {
  padding-top: 10px;
  padding-bottom: 10px;
}
.post-title {
  font-weight: 600;
}
.post-body {
  line-height: 1.95;
}
.post-body blockquote {
  border-left-color: #297c70;
  background: #f2f7f5;
  padding: 12px 18px;
}
.post-button .btn {
  border-color: #297c70;
  color: #297c70;
  border-radius: 6px;
}
.post-button .btn:hover {
  background: #297c70;
  color: #fff;
}
.site-author-name {
  color: #183d3b;
}
.footer {
  color: #73827f;
}

.main-inner .post-block, .header .header-inner {
  border-radius: 14px;
}
body {
  background: linear-gradient(rgba(244, 243, 238, .76), rgba(244, 243, 238, .76)), url('/images/background.jpg') center / cover fixed;
}
.footer {
  background: rgba(255, 255, 255, .9);
  border-radius: 12px;
  padding: 16px;
}
@media (max-width: 767px) {
  body {
    background-attachment: scroll;
  }
}
/* 背景图片单独虚化，正文保持清晰。 */
body {
  background: #f4f3ee;
  position: relative;
  isolation: isolate;
}
body::before {
  content: '';
  position: fixed;
  inset: -12px;
  z-index: -1;
  background: linear-gradient(rgba(244, 243, 238, .18), rgba(244, 243, 238, .18)), url('/images/background.jpg') center / cover;
  filter: blur(6px);
  pointer-events: none;
}
/* 页脚放在页面底部，短页面不再停在图片中央。 */
body {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  height: auto;
}
.main {
  flex: 1 0 auto;
}
.footer, .footer.footer-fixed {
  position: relative;
  flex-shrink: 0;
  margin-top: auto;
  padding: 18px 0;
  background: transparent;
  border-radius: 0;
}
.footer .footer-inner {
  width: max-content;
  max-width: calc(100% - 32px);
  margin: 0 auto;
  padding: 10px 20px;
  background: rgba(255, 255, 255, .78);
  border-radius: 12px;
}

/* 小互动只覆盖视觉层，不阻挡阅读与点击。 */
.miao-glow {
  position: fixed;
  left: -90px;
  top: -90px;
  width: 180px;
  height: 180px;
  background: radial-gradient(circle, rgba(255, 229, 238, .22), transparent 70%);
  pointer-events: none;
  z-index: 999;
  opacity: 0;
  transition: opacity .25s;
}
.miao-glow.is-visible {
  opacity: 1;
}
.miao-petal {
  position: fixed;
  width: 8px;
  height: 12px;
  background: #efb6c7;
  border-radius: 70% 15% 70% 15%;
  pointer-events: none;
  z-index: 1000;
}
.miao-petal-button {
  display: block;
  margin: 14px auto 0;
  padding: 3px 9px;
  border: 0;
  border-radius: 50%;
  background: transparent;
  color: #ecc3cf;
  cursor: pointer;
  font-size: 21px;
  transition: transform .2s, color .2s;
}
.miao-petal-button:hover {
  transform: rotate(22deg);
  color: #fff;
}
.miao-petal-button:focus-visible {
  outline: 2px solid #ecc3cf;
  outline-offset: 3px;
}
@media (prefers-reduced-motion: reduce) {
  .miao-glow, .miao-petal {
    display: none;
  }
  .miao-petal-button {
    transition: none;
  }
  .miao-petal-button:hover {
    transform: none;
  }
}

/* 系列标记随文章名称自动生成，颜色之外也用文字区分。 */
article[data-miao-palette='blue'] {
  --series-ink: #245d85;
  --series-tint: #edf6fc;
  --series-line: #8fc5e4;
}
article[data-miao-palette='violet'] {
  --series-ink: #694487;
  --series-tint: #f6effb;
  --series-line: #c2a1df;
}
article[data-miao-palette='rose'] {
  --series-ink: #943c5b;
  --series-tint: #fff0f4;
  --series-line: #e4a5ba;
}
article[data-miao-palette='gold'] {
  --series-ink: #805a16;
  --series-tint: #fff8e8;
  --series-line: #dfc07a;
}
article[data-miao-palette='green'] {
  --series-ink: #2f6b50;
  --series-tint: #edf8f0;
  --series-line: #91c7a5;
}
.post-content[data-miao-series] {
  background: linear-gradient(160deg, var(--series-tint), #fff 75%);
  border-top: 4px solid var(--series-line);
}
.miao-series-badge {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  margin-bottom: 16px;
  padding: 5px 13px 5px 5px;
  border: 1px solid var(--series-line);
  border-radius: 9px;
  background: var(--series-tint);
  color: var(--series-ink);
  font-size: 13px;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 1px;
}
.miao-series-icon {
  display: inline-flex;
  position: relative;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 30px;
  height: 30px;
  border: 1px solid var(--series-line);
  border-radius: 6px;
  background: var(--series-tint);
  color: var(--series-ink);
  font-family: Arial, sans-serif;
  line-height: 1;
  letter-spacing: 0;
}
.miao-series-icon b {
  font-size: 17px;
}
.miao-series-icon small {
  position: absolute;
  top: 3px;
  left: 4px;
  font-size: 7px;
}
.posts-collapse .miao-series-archive-icon {
  display: inline-flex;
  vertical-align: middle;
  margin-right: 9px;
}
.posts-collapse .miao-series-icon {
  width: 26px;
  height: 26px;
}
.posts-collapse .miao-series-icon b {
  font-size: 15px;
}
.posts-collapse article[data-miao-series] .post-title-link {
  color: var(--series-ink);
}
.posts-collapse article[data-miao-series] .post-header {
  border-bottom-color: var(--series-line);
}
