body {
  background: #f4f3ee;
}
.header-inner, .sidebar-inner, .post-block, .pagination {
  border-radius: 14px;
  overflow: hidden;
}
.site-brand-container {
  background: #183d3b;
  padding: 32px 18px;
}
.site-title {
  font-size: 20px;
  font-weight: 600;
  letter-spacing: 0;
}
.site-subtitle {
  color: #dce9e4;
  margin-top: 12px;
  font-size: 13px;
}
.menu-item a {
  padding-top: 10px;
  padding-bottom: 10px;
}
.post-title {
  font-weight: 600;
}
.post-body {
  line-height: 1.95;
}
.post-body blockquote {
  border-left-color: #297c70;
  background: #f2f7f5;
  padding: 12px 18px;
}
.post-button .btn {
  border-color: #297c70;
  color: #297c70;
  border-radius: 6px;
}
.post-button .btn:hover {
  background: #297c70;
  color: #fff;
}
.site-author-name {
  color: #183d3b;
}
.footer {
  color: #73827f;
}

.main-inner .post-block, .header .header-inner {
  border-radius: 14px;
}
body {
  background: linear-gradient(rgba(244, 243, 238, .76), rgba(244, 243, 238, .76)), url('/images/background.jpg') center / cover fixed;
}
.footer {
  background: rgba(255, 255, 255, .9);
  border-radius: 12px;
  padding: 16px;
}
@media (max-width: 767px) {
  body {
    background-attachment: scroll;
  }
}
