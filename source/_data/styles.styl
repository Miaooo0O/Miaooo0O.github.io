body {
  background: #f4f3ee;
}
.header-inner, .sidebar-inner, .post-block, .pagination {
  border-radius: 14px;
  overflow: hidden;
}
.site-brand-container {
  background: #183d3b;
  padding: 32px 18px;
}
.site-title {
  font-size: 20px;
  font-weight: 600;
  letter-spacing: 0;
}
.site-subtitle {
  color: #dce9e4;
  margin-top: 12px;
  font-size: 13px;
}
.menu-item a {
  padding-top: 10px;
  padding-bottom: 10px;
}
.post-title {
  font-weight: 600;
}
.post-body {
  line-height: 1.95;
}
.post-body blockquote {
  border-left-color: #297c70;
  background: #f2f7f5;
  padding: 12px 18px;
}
.post-button .btn {
  border-color: #297c70;
  color: #297c70;
  border-radius: 6px;
}
.post-button .btn:hover {
  background: #297c70;
  color: #fff;
}
.site-author-name {
  color: #183d3b;
}
.footer {
  color: #73827f;
}

.main-inner .post-block, .header .header-inner {
  border-radius: 14px;
}
body {
  background: linear-gradient(rgba(244, 243, 238, .76), rgba(244, 243, 238, .76)), url('/images/background.jpg') center / cover fixed;
}
.footer {
  background: rgba(255, 255, 255, .9);
  border-radius: 12px;
  padding: 16px;
}
@media (max-width: 767px) {
  body {
    background-attachment: scroll;
  }
}
/* 背景图片单独虚化，正文保持清晰。 */
body {
  background: #f4f3ee;
  position: relative;
  isolation: isolate;
}
body::before {
  content: '';
  position: fixed;
  inset: -12px;
  z-index: -1;
  background: linear-gradient(rgba(244, 243, 238, .18), rgba(244, 243, 238, .18)), url('/images/background.jpg') center / cover;
  filter: blur(6px);
  pointer-events: none;
}
/* 页脚放在页面底部，短页面不再停在图片中央。 */
body {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  height: auto;
}
.main {
  flex: 1 0 auto;
}
.footer, .footer.footer-fixed {
  position: relative;
  flex-shrink: 0;
  margin-top: auto;
  padding: 18px 0;
  background: transparent;
  border-radius: 0;
}
.footer .footer-inner {
  width: max-content;
  max-width: calc(100% - 32px);
  margin: 0 auto;
  padding: 10px 20px;
  background: rgba(255, 255, 255, .78);
  border-radius: 12px;
}

/* 小互动只覆盖视觉层，不阻挡阅读与点击。 */
.miao-glow {
  position: fixed;
  left: -90px;
  top: -90px;
  width: 180px;
  height: 180px;
  background: radial-gradient(circle, rgba(255, 229, 238, .22), transparent 70%);
  pointer-events: none;
  z-index: 999;
  opacity: 0;
  transition: opacity .25s;
}
.miao-glow.is-visible {
  opacity: 1;
}
.miao-petal {
  position: fixed;
  width: 8px;
  height: 12px;
  background: #efb6c7;
  border-radius: 70% 15% 70% 15%;
  pointer-events: none;
  z-index: 1000;
}
.miao-petal-button {
  display: block;
  margin: 14px auto 0;
  padding: 3px 9px;
  border: 0;
  border-radius: 50%;
  background: transparent;
  color: #ecc3cf;
  cursor: pointer;
  font-size: 21px;
  transition: transform .2s, color .2s;
}
.miao-petal-button:hover {
  transform: rotate(22deg);
  color: #fff;
}
.miao-petal-button:focus-visible {
  outline: 2px solid #ecc3cf;
  outline-offset: 3px;
}
@media (prefers-reduced-motion: reduce) {
  .miao-glow, .miao-petal {
    display: none;
  }
  .miao-petal-button {
    transition: none;
  }
  .miao-petal-button:hover {
    transform: none;
  }
}
